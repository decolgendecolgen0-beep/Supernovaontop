--- ==========================================
--- 5. FITUR ANTI-AFK (AUTO CLICK 1 MENIT)
--- ==========================================
UtilityTab:CreateToggle({
   Name = "Anti-AFK Auto Clicker",
   CurrentValue = false,
   Flag = "Toggle_AntiAFK",
   Callback = function(Value)
      AntiAFK = Value
      task.spawn(function()
         local VirtualUser = game:GetService("VirtualUser")
         while AntiAFK do
            task.wait(60) -- Tunggu 1 menit (60 detik)
            if AntiAFK then
               -- Melakukan simulasi klik kiri mouse pada layar
               VirtualUser:Button1Down(Vector2.new(0,0))
               task.wait(0.1)
               VirtualUser:Button1Up(Vector2.new(0,0))
            end
         end
      end)
   end,
})

-- Notifikasi Skrip Dimuat
Rayfield:Notify({
   Title = "Skrip Berhasil Dimuat",
   Content = "Semua fitur (Farm, Sell, Upgrade & Anti-AFK) telah aktif.",
   Duration = 3,
   Image = 4483362458,
})
