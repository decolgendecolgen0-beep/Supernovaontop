-- Memuat Library Rayfield GUI
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Membuat Window Utama
local Window = Rayfield:CreateWindow({
   Name = "Auto-Farm Hub | DIZ",
   LoadingTitle = "Mengaktifkan Skrip...",
   LoadingSubtitle = "by DIZ",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "DIZConfig",
      FileName = "MainConfig"
   }
})

-- State Variabel Global
local AutoFarm = false
local AutoSell = false
local AutoUpgradeMoney = false
local AutoUpgradeLuck = false
local AntiAFK = false

-- Membuat Tab Utama, Upgrade, & Utility
local MainTab = Window:CreateTab("Fitur Utama", 4483362458)
local UpgradeTab = Window:CreateTab("Auto Upgrade", 4483362458)
local UtilityTab = Window:CreateTab("Utility", 4483362458)

--- ==========================================
--- 1. FITUR AUTO FARM KOIN
--- ==========================================
MainTab:CreateToggle({
   Name = "Auto Farm Koin",
   CurrentValue = false,
   Flag = "Toggle_Farm",
   Callback = function(Value)
      AutoFarm = Value
      task.spawn(function()
         while AutoFarm do
            local args = {
               [1] = 1.9359413893912116,
               [2] = Vector3.new(-1169.3837890625, 0.7260000109672546, 79.91975402832031),
               [3] = "Zeus Coin",
               [4] = Vector3.new(-1168.00341796875, 0.7260000109672546, 85.75880432128906),
               [6] = 3
            }

            local events = game:GetService("ReplicatedStorage"):FindFirstChild("Assets") 
                and game:GetService("ReplicatedStorage").Assets:FindFirstChild("Events")
            
            if events and events:FindFirstChild("CoinLanded") then
               events.CoinLanded:FireServer(unpack(args))
            end

            task.wait(0.1)
         end
      end)
   end,
})

--- ==========================================
--- 2. FITUR AUTO SELL
--- ==========================================
MainTab:CreateToggle({
   Name = "Auto Sell",
   CurrentValue = false,
   Flag = "Toggle_Sell",
   Callback = function(Value)
      AutoSell = Value
      task.spawn(function()
         while AutoSell do
            local events = game:GetService("ReplicatedStorage"):FindFirstChild("Assets") 
                and game:GetService("ReplicatedStorage").Assets:FindFirstChild("Events")
            
            if events and events:FindFirstChild("SellAll") then
               events.SellAll:FireServer()
            end

            task.wait(2)
         end
      end)
   end,
})

--- ==========================================
--- 3. FITUR AUTO UPGRADE MONEY
--- ==========================================
UpgradeTab:CreateToggle({
   Name = "Auto Upgrade Money",
   CurrentValue = false,
   Flag = "Toggle_UpgMoney",
   Callback = function(Value)
      AutoUpgradeMoney = Value
      task.spawn(function()
         while AutoUpgradeMoney do
            local args = {
               [1] = "Value Multiplier"
            }

            local events = game:GetService("ReplicatedStorage"):FindFirstChild("Assets") 
                and game:GetService("ReplicatedStorage").Assets:FindFirstChild("Events")
            
            if events and events:FindFirstChild("RequestUpgrade") then
               events.RequestUpgrade:FireServer(unpack(args))
            end

            task.wait(1)
         end
      end)
   end,
})

--- ==========================================
--- 4. FITUR AUTO UPGRADE LUCK
--- ==========================================
UpgradeTab:CreateToggle({
   Name = "Auto Upgrade Luck",
   CurrentValue = false,
   Flag = "Toggle_UpgLuck",
   Callback = function(Value)
      AutoUpgradeLuck = Value
      task.spawn(function()
         while AutoUpgradeLuck do
            local args = {
               [1] = "Luck Multiplier"
            }

            local events = game:GetService("ReplicatedStorage"):FindFirstChild("Assets") 
